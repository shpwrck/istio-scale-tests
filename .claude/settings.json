{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(helm version*)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform version)",
      "Bash(kubectl version --client*)",
      "Bash(oc version --client*)",
      "Bash(tests/lib/verify.sh)",
      "Bash(tests/lib/verify.sh *)",
      "Bash(tests/lib/test/bats-core/bin/bats *)"
    ],
    "deny": [
      "Read(./terraform/**/*.tfstate)",
      "Read(./terraform/**/*.tfstate.*)",
      "Read(./terraform/rosa-hcp/kubeconfig)"
    ]
  }
}
