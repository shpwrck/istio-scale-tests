# Worked example run config for the churn-dataplane suite (README, "Run config").
# A quick functional sweep: mesh sizes 1 and 2, churn rates 1 and 2 ops/s over 3
# churn-target Deployments (1 <-> 2 replicas), 20 s windows at 50 QPS
# (2 mesh sizes x 2 churn rates = 4 combos).
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
#
# Sweep (runs 001 and 006 per mesh size, 002/003 per combo, then 005), and a report
# of one sweep:
#   ./tests/churn-dataplane/004-run-sweep.sh --config tests/churn-dataplane/configs/smoke.env --dry-run
#   ./tests/churn-dataplane/004-run-sweep.sh --config tests/churn-dataplane/configs/smoke.env
#   ./tests/churn-dataplane/005-report-results.sh --config tests/churn-dataplane/configs/smoke.env \
#     --results-dir tests/churn-dataplane/results/smoke/sweep-<RUN_ID> --format md
#   ./tests/churn-dataplane/006-cleanup.sh --config tests/churn-dataplane/configs/smoke.env
# Standalone, 001-003 still take --source-context (and --remote-contexts; 003 also
# --churn-rate):
#   ./tests/churn-dataplane/001-setup-coexec-test.sh --config tests/churn-dataplane/configs/smoke.env \
#     --source-context <mesh-a-ctx> --remote-contexts <mesh-b-ctx>
#
# Keep real context names out of git: copy this file to
# tests/churn-dataplane/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>

# Churn targets (shared with the churn suite's keys).
CHURN_DEPLOYMENT_COUNT=3
CHURN_BASE_REPLICAS=1
CHURN_SCALE_TO_REPLICAS=2

# Sweep axes (004), CSV.
COEXEC_MESH_SIZES=1,2
COEXEC_CHURN_RATES=1,2

# Windows and load.
COEXEC_BASELINE_DURATION_SEC=20
COEXEC_CHURN_DURATION_SEC=20
COEXEC_QPS=50
COEXEC_NUM_CONNECTIONS=4
COEXEC_SETTLE_SEC=5
COEXEC_INTER_COMBO_SETTLE_SEC=5

# Reachability check before each baseline (tests/lib/reach.sh).
REACH_REQUESTS=5

# Results under the repo root (gitignored); a sweep adds sweep-<RUN_ID>/.
COEXEC_RESULTS_DIR=tests/churn-dataplane/results/smoke
