# Worked example run config for the propagation suite (README, "Run config").
# A quick functional sweep: mesh sizes 1 and 2, 3 iterations each (6 iterations).
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
# --collect-metrics stays a flag (the sweep always writes TSVs; --tsv is a 002 flag).
#
# Sweep (runs 007/001/002 per mesh size, then 005), and a report of one sweep:
#   ./tests/propagation/006-run-sweep.sh --config tests/propagation/configs/smoke.env --dry-run
#   ./tests/propagation/006-run-sweep.sh --config tests/propagation/configs/smoke.env
#   ./tests/propagation/005-report-results.sh --config tests/propagation/configs/smoke.env \
#     --results-dir tests/propagation/results/smoke/sweep-<RUN_ID> --format markdown
#   ./tests/propagation/007-cleanup.sh --config tests/propagation/configs/smoke.env
# Standalone, 002 still takes --source-context (and --remote-contexts):
#   ./tests/propagation/001-setup-propagation-test.sh --config tests/propagation/configs/smoke.env
#   ./tests/propagation/002-run-endpoint-probe.sh --config tests/propagation/configs/smoke.env \
#     --source-context <mesh-a-ctx> --remote-contexts <mesh-b-ctx> --tsv
#
# Keep real context names out of git: copy this file to
# tests/propagation/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>

# Sweep axis (006), CSV.
PROPAGATION_MESH_SIZES=1,2

# Iterations and timing.
PROPAGATION_ITERATIONS=3
PROPAGATION_TIMEOUT_SEC=60
PROPAGATION_SETTLE_SEC=3

# Results under the repo root (gitignored); a sweep adds sweep-<RUN_ID>/.
PROPAGATION_RESULTS_DIR=tests/propagation/results/smoke
