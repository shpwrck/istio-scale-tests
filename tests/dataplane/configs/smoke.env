# Worked example run config for the dataplane suite (README, "Run config").
# A quick functional sweep: mesh sizes 1 and 2, QPS 10 and 100, 10 s per level
# (2 mesh sizes x 2 QPS levels = 4 combos).
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
#
# Sweep (runs 001/002/005 per mesh size, then 004), and a report of one sweep:
#   ./tests/dataplane/003-run-sweep.sh --config tests/dataplane/configs/smoke.env --dry-run
#   ./tests/dataplane/003-run-sweep.sh --config tests/dataplane/configs/smoke.env
#   ./tests/dataplane/004-report-results.sh --config tests/dataplane/configs/smoke.env \
#     --results-dir tests/dataplane/results/smoke/sweep-<RUN_ID> --format markdown
#   ./tests/dataplane/005-cleanup.sh --config tests/dataplane/configs/smoke.env
# Standalone, 001 and 002 still take --source-context (and --remote-contexts):
#   ./tests/dataplane/001-setup-dataplane-test.sh --config tests/dataplane/configs/smoke.env \
#     --source-context <mesh-a-ctx> --remote-contexts <mesh-b-ctx>
#
# Keep real context names out of git: copy this file to
# tests/dataplane/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>

# Sweep axes (003), CSV.
DATAPLANE_MESH_SIZES=1,2
DATAPLANE_QPS_LEVELS=10,100

# Load per QPS level, and the waits around it.
DATAPLANE_DURATION_SEC=10
DATAPLANE_NUM_CONNECTIONS=4
DATAPLANE_SETTLE_SEC=10
DATAPLANE_WARMUP_DURATION_SEC=2
DATAPLANE_INTER_COMBO_SETTLE_SEC=5

# Reachability check before the load (tests/lib/reach.sh).
REACH_REQUESTS=5

# Results under the repo root (gitignored); a sweep adds sweep-<RUN_ID>/.
DATAPLANE_RESULTS_DIR=tests/dataplane/results/smoke
