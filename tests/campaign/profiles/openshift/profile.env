# openshift profile: existing OpenShift clusters (docs/runbooks/existing-cluster-lab), sized
# for a small lab: 2 members of about 20 CPU, the small-istiod override, a shared hub.
# The runner's keys (config/options.env, Campaign runner).
# Parsed, never sourced: KEY=value only (tests/lib/config.sh). No context names here: pass
# --contexts and --hub-context to tests/campaign/001-run-profile.sh.

# Namespace scaling last: it leaves its namespaces undiscovered, not deleted.
CAMPAIGN_SUITES=dataplane,propagation,churn,churn-dataplane,tuning,controlplane
CAMPAIGN_DEADLINE_MIN=0
CAMPAIGN_PREFLIGHT_ECHO=1
CAMPAIGN_PREFLIGHT_BETWEEN=1
CAMPAIGN_TUNING_SUITE=propagation
CAMPAIGN_TUNING_PROFILES=
