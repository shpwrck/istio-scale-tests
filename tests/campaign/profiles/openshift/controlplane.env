# openshift profile: existing OpenShift clusters (docs/runbooks/existing-cluster-lab), sized
# for a small lab: 2 members of about 20 CPU, the small-istiod override, a shared hub.
# The controlplane sweep's --config (its keys: config/options.env).
# Parsed, never sourced: KEY=value only (tests/lib/config.sh). No context names here: pass
# --contexts and --hub-context to tests/campaign/001-run-profile.sh.

# Namespace scaling at lab size (tests/controlplane/configs/ns-scaling-lab.env).
CONTROLPLANE_MESH_SIZES=1
CONTROLPLANE_SERVICES_PER_NAMESPACES=2
CONTROLPLANE_NAMESPACE_COUNTS=100,200,400
CONTROLPLANE_SIDECAR_SCOPINGS=none,namespace,wide
CONTROLPLANE_WORKLOAD_MODE=config-only
CONTROLPLANE_MEASUREMENT_POD_COUNTS=4
CONTROLPLANE_OUTSIDE_NAMESPACES=200
CONTROLPLANE_OUTSIDE_MODES=unlabeled,labeled
CONTROLPLANE_SETTLE_SEC=45
CONTROLPLANE_PROBE_SETTLE_SEC=45
CONTROLPLANE_CONFIG_DUMP_SAMPLES=4
CONTROLPLANE_MEM_STOP_PCT=70
CONTROLPLANE_SERIES_RETIRE=undiscover
