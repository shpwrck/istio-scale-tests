# kind profile: a hub and 2 members on one machine (docs/runbooks/kind-lab). Small sizes:
# a full pass through every suite that checks the pipeline end to end, not a measurement.
# The churn-dataplane sweep's --config (its keys: config/options.env).
# Parsed, never sourced: KEY=value only (tests/lib/config.sh). No context names here: pass
# --contexts and --hub-context to tests/campaign/001-run-profile.sh.

CHURN_DEPLOYMENT_COUNT=3
CHURN_BASE_REPLICAS=1
CHURN_SCALE_TO_REPLICAS=2
COEXEC_CHURN_RATES=1
COEXEC_BASELINE_DURATION_SEC=20
COEXEC_CHURN_DURATION_SEC=20
COEXEC_QPS=50
COEXEC_NUM_CONNECTIONS=4
COEXEC_SETTLE_SEC=5
COEXEC_INTER_COMBO_SETTLE_SEC=5
REACH_REQUESTS=5
