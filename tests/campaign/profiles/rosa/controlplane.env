# rosa profile: ROSA HCP, a hub and 4 members (docs/runbooks/rosa-validation), for an
# unattended night. Every sweep grows the mesh 1 to 4 members (mesh sizes empty = all).
# The controlplane sweep's --config (its keys: config/options.env).
# Parsed, never sourced: KEY=value only (tests/lib/config.sh). No context names here: pass
# --contexts and --hub-context to tests/campaign/001-run-profile.sh.

# Namespace scaling at customer scale on the first member, the memory guard on all
# (tests/controlplane/configs/ns-scaling-rosa.env). Needs istiod sized for it (8Gi request).
CONTROLPLANE_MESH_SIZES=1
CONTROLPLANE_SERVICES_PER_NAMESPACES=1
CONTROLPLANE_NAMESPACE_COUNTS=250,1000,2000,4000
CONTROLPLANE_SIDECAR_SCOPINGS=namespace,wide
CONTROLPLANE_WORKLOAD_MODE=config-only
CONTROLPLANE_MEASUREMENT_POD_COUNTS=8
CONTROLPLANE_OUTSIDE_NAMESPACES=2000
CONTROLPLANE_OUTSIDE_MODES=unlabeled,labeled
CONTROLPLANE_SETTLE_SEC=45
CONTROLPLANE_PROBE_SETTLE_SEC=45
CONTROLPLANE_CONFIG_DUMP_SAMPLES=4
CONTROLPLANE_CONFIG_DUMP_TIMEOUT_S=120
CONTROLPLANE_WAIT_TIMEOUT_SEC=900
CONTROLPLANE_MEM_STOP_PCT=70
CONTROLPLANE_SERIES_RETIRE=undiscover
CONTROLPLANE_NS_DELETE_SEC_PER_NS=1.0
