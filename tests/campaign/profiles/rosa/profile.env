# rosa profile: ROSA HCP, a hub and 4 members (docs/runbooks/rosa-validation), for an
# unattended night. Every sweep grows the mesh 1 to 4 members (mesh sizes empty = all).
# The runner's keys (config/options.env, Campaign runner).
# Parsed, never sourced: KEY=value only (tests/lib/config.sh). No context names here: pass
# --contexts and --hub-context to tests/campaign/001-run-profile.sh.

# Namespace scaling last: it leaves thousands of namespaces that only the teardown removes.
CAMPAIGN_SUITES=dataplane,propagation,churn,churn-dataplane,tuning,controlplane
# 8.5 h: started at T0+1:30, the run ends by T0+10:00, before the planned teardown. Arm
# terraform/rosa-hcp/scripts/003-auto-teardown.sh separately: this deadline stops tests,
# not billing.
CAMPAIGN_DEADLINE_MIN=510
CAMPAIGN_PREFLIGHT_ECHO=1
CAMPAIGN_PREFLIGHT_BETWEEN=1
CAMPAIGN_TUNING_SUITE=propagation
CAMPAIGN_TUNING_PROFILES=
