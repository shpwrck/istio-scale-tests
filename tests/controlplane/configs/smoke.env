# Worked example run config for the controlplane suite (README, "Run config").
# A quick functional sweep: 5 services x 1 replica in one namespace, mesh sizes 1 and 2,
# Sidecar scoping none and namespace (4 combos), a 20 s window.
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
#
# Standalone lifecycle (one window, then cleanup):
#   ./tests/controlplane/001-setup-controlplane-test.sh --config tests/controlplane/configs/smoke.env
#   ./tests/controlplane/002-collect-resource-metrics.sh --config tests/controlplane/configs/smoke.env
#   ./tests/controlplane/005-cleanup.sh --config tests/controlplane/configs/smoke.env
# Sweep (runs 001/002/005 per combo, then 004), and a report of one sweep:
#   ./tests/controlplane/003-run-sweep.sh --config tests/controlplane/configs/smoke.env --dry-run
#   ./tests/controlplane/003-run-sweep.sh --config tests/controlplane/configs/smoke.env
#   ./tests/controlplane/004-report-results.sh --config tests/controlplane/configs/smoke.env \
#     --results-dir tests/controlplane/results/smoke/sweep-<RUN_ID> --format markdown
#
# Keep real context names out of git: copy this file to
# tests/controlplane/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>

# One combo (001, 002), and each sweep axis below that has no plural key.
CONTROLPLANE_SERVICE_COUNT=5
CONTROLPLANE_REPLICAS_PER_SERVICE=1
CONTROLPLANE_NAMESPACE_COUNT=1
CONTROLPLANE_SIDECAR_SCOPING=none

# Sweep axes (003), CSV.
CONTROLPLANE_MESH_SIZES=1,2
CONTROLPLANE_SIDECAR_SCOPINGS=none,namespace

# Window and collection.
CONTROLPLANE_SETTLE_SEC=20
CONTROLPLANE_CONFIG_DUMP_SAMPLES=1

# Results under the repo root (gitignored); a sweep adds sweep-<RUN_ID>/.
CONTROLPLANE_RESULTS_DIR=tests/controlplane/results/smoke
