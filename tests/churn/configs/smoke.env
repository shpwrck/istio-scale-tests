# Worked example run config for the churn suite (README, "Run config").
# A quick functional sweep: mesh sizes 1 and 2, 2 and 4 churn-target Deployments
# scaled 1 -> 2, 2 iterations each (2 mesh sizes x 2 intensities = 4 combos).
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
#
# Sweep (runs 001/002/005 per combo, then 004), and a report of one sweep:
#   ./tests/churn/003-run-sweep.sh --config tests/churn/configs/smoke.env --dry-run
#   ./tests/churn/003-run-sweep.sh --config tests/churn/configs/smoke.env
#   ./tests/churn/004-report-results.sh --config tests/churn/configs/smoke.env \
#     --results-dir tests/churn/results/smoke/sweep-<RUN_ID> --format md
#   ./tests/churn/005-cleanup.sh --config tests/churn/configs/smoke.env
# Standalone (one combo), 002 still takes --source-context (and --remote-contexts):
#   ./tests/churn/001-setup-churn-test.sh --config tests/churn/configs/smoke.env
#   ./tests/churn/002-run-churn-probe.sh --config tests/churn/configs/smoke.env \
#     --source-context <mesh-a-ctx> --remote-contexts <mesh-b-ctx>
#
# Keep real context names out of git: copy this file to
# tests/churn/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>

# One combo (001, 002): Deployments and the replica range.
CHURN_DEPLOYMENT_COUNT=2
CHURN_BASE_REPLICAS=1
CHURN_SCALE_TO_REPLICAS=2

# Sweep axes (003), CSV.
CHURN_MESH_SIZES=1,2
CHURN_INTENSITIES=2,4

# Iterations and timing.
CHURN_ITERATIONS=2
CHURN_TIMEOUT_SEC=60
CHURN_SETTLE_SEC=3

# Results under the repo root (gitignored); a sweep adds sweep-<RUN_ID>/.
CHURN_RESULTS_DIR=tests/churn/results/smoke
