# tests/lib/test/config.bats: every form load_config accepts. Sourcing this file with
# `set -a` must give the same values (the shell-equivalence test checks that).

CONTROLPLANE_SERVICE_COUNT=5
export CONTROLPLANE_REPLICAS_PER_SERVICE=2
CONTROLPLANE_SIDECAR_SCOPING='namespace'
CONTROLPLANE_RESULTS_DIR="results dir/with space"
SETUP_CONTEXTS=ctx-a,ctx-b # trailing comment
  CONTROLPLANE_SETTLE_SEC=7
CONTROLPLANE_TRAFFIC_CONFIG=''
SCALE_TARGET_FRACTION=0.5
METRICS_SCRAPE_TIMEOUT='a$b`c "d"'
FANOUT_PF_BASE=a=b:c/d@e%f+g-h.i,j
CAP_TOP_TIMEOUT=   # empty value, then a comment
