# Worked example run config for the gateway-api suite (README, "Run config").
# A quick read of a deployed check: 5 requests per member ingress x scenario host, a 2-minute
# bound on the status wait and the data-plane gate, and no istioctl evidence.
#
# Keys are config/options.env knobs (and SETUP_CONTEXTS); a flag still beats a key.
# Parsed, never sourced: KEY=value only, no $ or ` outside single quotes.
#
#   ./tests/gateway-api/001-run-ingress-check.sh --config tests/gateway-api/configs/smoke.env \
#     --contexts <mesh-a-ctx>,<mesh-b-ctx> --workload-context <mesh-b-ctx> --dry-run
#   ./tests/gateway-api/001-run-ingress-check.sh --config tests/gateway-api/configs/smoke.env \
#     --contexts <mesh-a-ctx>,<mesh-b-ctx> --workload-context <mesh-b-ctx> --hub-context <hub-ctx>
#
# Keep real context names out of git: copy this file to
# tests/gateway-api/configs/<name>.local.env (gitignored) and set them there:
# SETUP_CONTEXTS=<mesh-a-ctx>,<mesh-b-ctx>
# GWAPI_WORKLOAD_CONTEXT=<mesh-b-ctx>
# GWAPI_HUB_CONTEXT=<hub-ctx>

# Traffic per member ingress x scenario host, and the per-request curl --max-time (s).
GWAPI_REQUESTS=5
GWAPI_TIMEOUT_SEC=5

# Bound (s) on the wait for the Gateway, the echo Deployments and every route's status, and then
# on the data-plane gate (S1 and S3 through every ingress).
GWAPI_WAIT_TIMEOUT_SEC=120

# Skip the istioctl endpoint evidence (1); 0 reads it when istioctl is on PATH.
GWAPI_SKIP_PROXY_CONFIG=1

# Results under the repo root (gitignored); each run adds run-<RUN_ID>/.
GWAPI_RESULTS_DIR=tests/gateway-api/results/smoke
