# Test-suite defaults. Sourced by config/versions.env; any value can be overridden
# from the environment. These keys (plus SETUP_CONTEXTS) are also the vocabulary of
# `--config FILE` run configs (tests/lib/config.sh), for the suites that take one.
#
# shellcheck shell=bash

# === istiod /metrics scrapes ===
# curl --max-time (s) for istiod /metrics scrapes. Raise it if large-mesh scrapes time out.
export METRICS_SCRAPE_TIMEOUT="${METRICS_SCRAPE_TIMEOUT:-30}"

# === Per-pod istiod fanout (tests/lib/fanout.sh) ===
# First local port for per-pod istiod port-forwards; each context gets FANOUT_CTX_STRIDE ports.
export FANOUT_PF_BASE="${FANOUT_PF_BASE:-21014}"
export FANOUT_CTX_STRIDE="${FANOUT_CTX_STRIDE:-20}"
# curl --max-time (s) for the per-pod fanout scrapes.
export FANOUT_METRICS_TIMEOUT="${FANOUT_METRICS_TIMEOUT:-${METRICS_SCRAPE_TIMEOUT}}"
# Readiness polls (0.5 s apart) after opening each port-forward.
export FANOUT_PF_READY_ATTEMPTS="${FANOUT_PF_READY_ATTEMPTS:-30}"
# A scrape smaller than this many bytes counts as failed.
export FANOUT_MIN_SCRAPE_BYTES="${FANOUT_MIN_SCRAPE_BYTES:-512}"
# Max spread (ms) of scrape times within one batch; above it the row is tagged incoherent.
export FANOUT_MAX_SKEW_MS="${FANOUT_MAX_SKEW_MS:-1000}"

# === istiod restart diagnostics (tests/lib/istiod-diag.sh; every suite, settable from --config) ===
# 0 turns the evidence capture off; restart detection and row status are unchanged.
export ISTIOD_DIAG_ENABLED="${ISTIOD_DIAG_ENABLED:-1}"
# kubectl --request-timeout of each capture call, passed unchanged (15 = 15s; 500ms, 2m).
export ISTIOD_DIAG_REQUEST_TIMEOUT="${ISTIOD_DIAG_REQUEST_TIMEOUT:-15}"
# Wall-clock budget (s) per capture; no call starts after it (rows say skipped_deadline).
export ISTIOD_DIAG_MAX_SEC="${ISTIOD_DIAG_MAX_SEC:-120}"
# Evidence folders per run; later restarts get index rows only (budget_exhausted).
export ISTIOD_DIAG_MAX_CAPTURES="${ISTIOD_DIAG_MAX_CAPTURES:-20}"
# Lines fetched (kubectl logs --tail) from a previous container's or an old pod's log.
export ISTIOD_DIAG_LOG_LINES="${ISTIOD_DIAG_LOG_LINES:-5000}"
# Bytes kept (the last ones) of each such log, after masking; gzipped on disk.
export ISTIOD_DIAG_LOG_BYTES="${ISTIOD_DIAG_LOG_BYTES:-1048576}"

# === Propagation Test ===
# Env only (not settable from --config): cleanup deletes this namespace.
export PROPAGATION_TEST_NAMESPACE="${PROPAGATION_TEST_NAMESPACE:-propagation-test}"
# Endpoint poll interval (ms).
export PROPAGATION_POLL_INTERVAL_MS="${PROPAGATION_POLL_INTERVAL_MS:-250}"
# Timeout per iteration (s).
export PROPAGATION_TIMEOUT_SEC="${PROPAGATION_TIMEOUT_SEC:-120}"
export PROPAGATION_ITERATIONS="${PROPAGATION_ITERATIONS:-10}"
# Settle time (s) after each iteration and between sweep mesh sizes.
export PROPAGATION_SETTLE_SEC="${PROPAGATION_SETTLE_SEC:-5}"
# Max wait (s) for the probe endpoint to drain between iterations; a miss is tagged DRAIN_TIMEOUT.
export PROPAGATION_DRAIN_TIMEOUT_SEC="${PROPAGATION_DRAIN_TIMEOUT_SEC:-20}"
# curl --max-time (s) for the propagation probe's istiod scrapes.
export PROPAGATION_METRICS_TIMEOUT="${PROPAGATION_METRICS_TIMEOUT:-${METRICS_SCRAPE_TIMEOUT}}"
# Watcher pod replicas per cluster; more proxies give more histogram samples.
export PROPAGATION_WATCHER_REPLICAS="${PROPAGATION_WATCHER_REPLICAS:-1}"
# Refuse sweeps larger than this (mesh sizes x iterations); env only, not --config.
export PROPAGATION_MAX_MATRIX="${PROPAGATION_MAX_MATRIX:-64}"
# Minimum samples before the report shows p95/p99 (otherwise N/A); 0 disables the check.
export PROPAGATION_PERCENTILE_MIN_N="${PROPAGATION_PERCENTILE_MIN_N:-20}"
# First local port for 004 snapshot port-forwards; apart from FANOUT_PF_BASE so 004 can run alongside 002.
export PROPAGATION_SNAPSHOT_PF_BASE="${PROPAGATION_SNAPSHOT_PF_BASE:-22014}"
# --- Run config: keys so one --config file can describe a whole propagation run (tests/lib/config.sh) ---
# 006 mesh sizes (CSV); empty = 1..number of contexts.
export PROPAGATION_MESH_SIZES="${PROPAGATION_MESH_SIZES:-}"
# Results dir of 002/004/005 and sweep base dir of 006 (absolute, or relative to the repo root).
export PROPAGATION_RESULTS_DIR="${PROPAGATION_RESULTS_DIR:-tests/propagation/results}"
# Max wait (s) in 001 setup for the watcher Deployments to become Available.
export PROPAGATION_WAIT_TIMEOUT_SEC="${PROPAGATION_WAIT_TIMEOUT_SEC:-300}"

# === Control-Plane Resource Test ===
# Env only (not settable from --config): 005 deletes this namespace.
export CONTROLPLANE_TEST_NAMESPACE="${CONTROLPLANE_TEST_NAMESPACE:-controlplane-test}"
export CONTROLPLANE_SERVICE_COUNT="${CONTROLPLANE_SERVICE_COUNT:-10}"
export CONTROLPLANE_REPLICAS_PER_SERVICE="${CONTROLPLANE_REPLICAS_PER_SERVICE:-3}"
export CONTROLPLANE_NAMESPACE_COUNT="${CONTROLPLANE_NAMESPACE_COUNT:-1}"
# Sidecar CR scoping: none (worst case), namespace, or explicit (one per Deployment).
export CONTROLPLANE_SIDECAR_SCOPING="${CONTROLPLANE_SIDECAR_SCOPING:-none}"
# Pods per cluster sampled for /config_dump size; 0 disables sampling.
export CONTROLPLANE_CONFIG_DUMP_SAMPLES="${CONTROLPLANE_CONFIG_DUMP_SAMPLES:-3}"
# Timeout (s) per /config_dump exec; a timed-out sample is dropped.
export CONTROLPLANE_CONFIG_DUMP_TIMEOUT_S="${CONTROLPLANE_CONFIG_DUMP_TIMEOUT_S:-30}"
# Refuse sweeps larger than this unless --force-large-matrix is given (env only, not --config).
export CONTROLPLANE_MAX_MATRIX="${CONTROLPLANE_MAX_MATRIX:-64}"
# Server-side-apply attempts and backoff (s) in 001 setup.
export CONTROLPLANE_APPLY_ATTEMPTS="${CONTROLPLANE_APPLY_ATTEMPTS:-3}"
export CONTROLPLANE_APPLY_BACKOFF_S="${CONTROLPLANE_APPLY_BACKOFF_S:-5}"
# Objects per server-side-apply batch in 001 setup; <= 0 applies everything at once.
export CONTROLPLANE_APPLY_CHUNK_OBJECTS="${CONTROLPLANE_APPLY_CHUNK_OBJECTS:-200}"
# Max wait (s) for the test namespace to finish deleting in 005 cleanup.
export CONTROLPLANE_NS_DELETE_TIMEOUT_SEC="${CONTROLPLANE_NS_DELETE_TIMEOUT_SEC:-300}"
# Max wait (s) in 001 setup for a terminating namespace to disappear before applying.
export CONTROLPLANE_SETUP_NS_WAIT_SEC="${CONTROLPLANE_SETUP_NS_WAIT_SEC:-${CONTROLPLANE_NS_DELETE_TIMEOUT_SEC}}"
# Grace period (s) for deleting workload pods before the namespace (must be > 0).
export CONTROLPLANE_CLEANUP_GRACE_SEC="${CONTROLPLANE_CLEANUP_GRACE_SEC:-5}"
# Proxy check: warn when a cluster's connected proxies (pilot_xds over its istiod pods)
# and its Running sidecar pods differ by more than this percent of the sidecar pods...
export CONTROLPLANE_PROXY_CHECK_TOLERANCE_PCT="${CONTROLPLANE_PROXY_CHECK_TOLERANCE_PCT:-10}"
# ...and by more than this many proxies, so small clusters don't warn on a one-proxy gap.
export CONTROLPLANE_PROXY_CHECK_MIN_DIFF="${CONTROLPLANE_PROXY_CHECK_MIN_DIFF:-2}"
# Traffic management per service: none, or vsdr (a VirtualService + DestinationRule).
export CONTROLPLANE_TRAFFIC_CONFIG="${CONTROLPLANE_TRAFFIC_CONFIG:-none}"
# vsdr: configure every Nth service (service i when i mod N == 0).
export CONTROLPLANE_VSDR_EVERY="${CONTROLPLANE_VSDR_EVERY:-1}"
# vsdr: DR subsets; the service's replicas are split over this many version Deployments (<= replicas).
export CONTROLPLANE_VSDR_SUBSETS="${CONTROLPLANE_VSDR_SUBSETS:-2}"
# --- Run config: keys so one --config file can describe a whole controlplane run (tests/lib/config.sh) ---
# 003 sweep axes (CSV). Mesh sizes: empty = 1..number of contexts; the others: empty = the singular key above.
export CONTROLPLANE_MESH_SIZES="${CONTROLPLANE_MESH_SIZES:-}"
export CONTROLPLANE_SERVICE_COUNTS="${CONTROLPLANE_SERVICE_COUNTS:-}"
export CONTROLPLANE_REPLICA_COUNTS="${CONTROLPLANE_REPLICA_COUNTS:-}"
export CONTROLPLANE_NAMESPACE_COUNTS="${CONTROLPLANE_NAMESPACE_COUNTS:-}"
export CONTROLPLANE_SIDECAR_SCOPINGS="${CONTROLPLANE_SIDECAR_SCOPINGS:-}"
export CONTROLPLANE_TRAFFIC_CONFIGS="${CONTROLPLANE_TRAFFIC_CONFIGS:-}"
# Delta window (s) between the baseline and final scrapes (002, 003); 003 also waits it after each cleanup.
export CONTROLPLANE_SETTLE_SEC="${CONTROLPLANE_SETTLE_SEC:-60}"
# Results dir of 002/004 and sweep base dir of 003 (absolute, or relative to the repo root).
export CONTROLPLANE_RESULTS_DIR="${CONTROLPLANE_RESULTS_DIR:-tests/controlplane/results}"
# Max wait (s) in 001 setup for the dummy Deployments to become Available.
export CONTROLPLANE_WAIT_TIMEOUT_SEC="${CONTROLPLANE_WAIT_TIMEOUT_SEC:-300}"

# === Data-Plane Latency Test ===
# Env only (not settable from --config): cleanup deletes this namespace.
export DATAPLANE_TEST_NAMESPACE="${DATAPLANE_TEST_NAMESPACE:-dataplane-test}"
export DATAPLANE_QPS_LEVELS="${DATAPLANE_QPS_LEVELS:-10,100,500,1000}"
export DATAPLANE_DURATION_SEC="${DATAPLANE_DURATION_SEC:-30}"
export DATAPLANE_NUM_CONNECTIONS="${DATAPLANE_NUM_CONNECTIONS:-8}"
export DATAPLANE_SETTLE_SEC="${DATAPLANE_SETTLE_SEC:-30}"
# Refuse sweeps larger than this unless --force-large-matrix is given (env only, not --config).
export DATAPLANE_MAX_MATRIX="${DATAPLANE_MAX_MATRIX:-64}"
export DATAPLANE_INTER_COMBO_SETTLE_SEC="${DATAPLANE_INTER_COMBO_SETTLE_SEC:-15}"
export DATAPLANE_WARMUP_DURATION_SEC="${DATAPLANE_WARMUP_DURATION_SEC:-5}"
export DATAPLANE_REPETITIONS="${DATAPLANE_REPETITIONS:-1}"
# fortio server pods per cluster, used by the local and cross-cluster targets alike (the June 2026 campaigns ran 1).
export DATAPLANE_SERVER_REPLICAS="${DATAPLANE_SERVER_REPLICAS:-2}"
# A row below this fraction of its target QPS is tagged QPS_SHORTFALL and dropped from n_valid.
export DATAPLANE_MIN_QPS_RATIO="${DATAPLANE_MIN_QPS_RATIO:-0.95}"
# A row whose share of HTTP 200 responses is below this is tagged ERROR_RATE_HIGH.
export DATAPLANE_MIN_PCT_200="${DATAPLANE_MIN_PCT_200:-0.99}"
# --- Run config: keys so one --config file can describe a whole dataplane run (tests/lib/config.sh) ---
# 003 mesh sizes (CSV); empty = 1..number of contexts.
export DATAPLANE_MESH_SIZES="${DATAPLANE_MESH_SIZES:-}"
# Results dir of 002/004 and sweep base dir of 003 (absolute, or relative to the repo root).
export DATAPLANE_RESULTS_DIR="${DATAPLANE_RESULTS_DIR:-tests/dataplane/results}"
# Max wait (s) in 001 setup for the fortio Deployments to become Available.
export DATAPLANE_WAIT_TIMEOUT_SEC="${DATAPLANE_WAIT_TIMEOUT_SEC:-300}"
# Max wait (s) in 005 cleanup for the test namespace to finish deleting.
export DATAPLANE_NS_DELETE_TIMEOUT_SEC="${DATAPLANE_NS_DELETE_TIMEOUT_SEC:-180}"

# === Remote reachability (dataplane, churn-dataplane; tests/lib/reach.sh) ===
# Cost for a target that never answers (targets run in parallel, so per run):
# ATTEMPTS x (REQUESTS/QPS + 2 x HTTP_TIMEOUT) + (ATTEMPTS-1) x RETRY + DETAIL_TIMEOUT,
# about 76 s at these defaults (3 x HTTP_TIMEOUT per check for an odd REQUESTS).
# Requests per target in the check before the load; 0 turns the check off.
export REACH_REQUESTS="${REACH_REQUESTS:-10}"
# QPS of the check (low on purpose: it tests coverage, not capacity).
export REACH_QPS="${REACH_QPS:-10}"
# Per-request timeout (s) of the check.
export REACH_HTTP_TIMEOUT_SEC="${REACH_HTTP_TIMEOUT_SEC:-3}"
# Timeout (s) of the one curl that fills `detail`. Envoy answers a blackholed remote only after 3 connect
# timeouts (1 try + Istio's default 2 retries, 10 s meshConfig.connectTimeout each); shorter reads as i/o timeout.
export REACH_DETAIL_TIMEOUT_SEC="${REACH_DETAIL_TIMEOUT_SEC:-35}"
# Checks per target in total; a target that is not REACHABLE is checked again, up to this many times.
export REACH_ATTEMPTS="${REACH_ATTEMPTS:-3}"
# Seconds between those checks (cross-cluster endpoints can lag a fresh setup).
export REACH_RETRY_SEC="${REACH_RETRY_SEC:-10}"
# warn: record and go on; fail: stop before the load when a remote is UNREACHABLE or UNKNOWN (exit 3).
export REACH_ON_UNREACHABLE="${REACH_ON_UNREACHABLE:-warn}"

# === Churn / Convergence Test ===
# Env only (not settable from --config): cleanup deletes this namespace.
export CHURN_TEST_NAMESPACE="${CHURN_TEST_NAMESPACE:-churn-test}"
export CHURN_DEPLOYMENT_COUNT="${CHURN_DEPLOYMENT_COUNT:-5}"
export CHURN_BASE_REPLICAS="${CHURN_BASE_REPLICAS:-1}"
export CHURN_SCALE_TO_REPLICAS="${CHURN_SCALE_TO_REPLICAS:-5}"
export CHURN_TIMEOUT_SEC="${CHURN_TIMEOUT_SEC:-120}"
export CHURN_POLL_INTERVAL_MS="${CHURN_POLL_INTERVAL_MS:-250}"
export CHURN_ITERATIONS="${CHURN_ITERATIONS:-5}"
# Settle time (s) after scale-down convergence (default for --settle).
export CHURN_SETTLE_SEC="${CHURN_SETTLE_SEC:-3}"
# --- Run config: keys so one --config file can describe a whole churn run (tests/lib/config.sh) ---
# 003 sweep axes (CSV). Mesh sizes: empty = 1..number of contexts; intensities
# (deployment counts): empty = CHURN_DEPLOYMENT_COUNT.
export CHURN_MESH_SIZES="${CHURN_MESH_SIZES:-}"
export CHURN_INTENSITIES="${CHURN_INTENSITIES:-}"
# Results dir of 002/004 and sweep base dir of 003 (absolute, or relative to the repo root).
export CHURN_RESULTS_DIR="${CHURN_RESULTS_DIR:-tests/churn/results}"
# Max wait (s) in 001 setup for the churn Deployments to become Available.
export CHURN_WAIT_TIMEOUT_SEC="${CHURN_WAIT_TIMEOUT_SEC:-300}"

# === Churn x Data-plane Co-execution Test (tests/churn-dataplane) ===
# Env only (not settable from --config): cleanup deletes this namespace.
export COEXEC_TEST_NAMESPACE="${COEXEC_TEST_NAMESPACE:-churn-dataplane-test}"
export COEXEC_BASELINE_DURATION_SEC="${COEXEC_BASELINE_DURATION_SEC:-60}"
export COEXEC_CHURN_DURATION_SEC="${COEXEC_CHURN_DURATION_SEC:-60}"
export COEXEC_CHURN_RATES="${COEXEC_CHURN_RATES:-1,5,10}"
export COEXEC_SETTLE_SEC="${COEXEC_SETTLE_SEC:-10}"
export COEXEC_INTER_COMBO_SETTLE_SEC="${COEXEC_INTER_COMBO_SETTLE_SEC:-15}"
export COEXEC_QPS="${COEXEC_QPS:-200}"
export COEXEC_NUM_CONNECTIONS="${COEXEC_NUM_CONNECTIONS:-8}"
export COEXEC_CHURN_SEED="${COEXEC_CHURN_SEED:-42}"
export COEXEC_REPETITIONS="${COEXEC_REPETITIONS:-1}"
# Max wait (s) for the test namespace to finish deleting in 006 cleanup.
export COEXEC_NS_DELETE_TIMEOUT_SEC="${COEXEC_NS_DELETE_TIMEOUT_SEC:-240}"
# Max wait (s) in 001 setup for a terminating namespace to disappear before applying.
export COEXEC_SETUP_NS_WAIT_SEC="${COEXEC_SETUP_NS_WAIT_SEC:-${COEXEC_NS_DELETE_TIMEOUT_SEC}}"
# Grace period (s) for deleting workload pods before the namespace (must be > 0).
export COEXEC_CLEANUP_GRACE_SEC="${COEXEC_CLEANUP_GRACE_SEC:-5}"
# fortio-server port: 001 sets it on the chart, 002/003 send load to it.
export COEXEC_SERVICE_PORT="${COEXEC_SERVICE_PORT:-8080}"
# A window whose share of HTTP 200 responses is below this is tagged ERROR_RATE_HIGH; 0 turns the rule off.
export COEXEC_MIN_PCT_200="${COEXEC_MIN_PCT_200:-0.99}"
# --- Run config: keys so one --config file can describe a whole churn-dataplane run (tests/lib/config.sh) ---
# The workload size comes from CHURN_DEPLOYMENT_COUNT, CHURN_BASE_REPLICAS and CHURN_SCALE_TO_REPLICAS.
# 004 mesh sizes (CSV); empty = 1..number of contexts.
export COEXEC_MESH_SIZES="${COEXEC_MESH_SIZES:-}"
# Sweep base dir of 004, results dir of 002/003/005 (absolute, or relative to the repo root).
export COEXEC_RESULTS_DIR="${COEXEC_RESULTS_DIR:-tests/churn-dataplane/results}"
# Max wait (s) in 001 setup for the Deployments to become Available.
export COEXEC_WAIT_TIMEOUT_SEC="${COEXEC_WAIT_TIMEOUT_SEC:-300}"
# Expected Running istiod pods on the source; 002/003 warn when the count differs. Empty = no check.
export COEXEC_ISTIOD_REPLICAS="${COEXEC_ISTIOD_REPLICAS:-}"

# === Tuning Profile Test ===
# Wait (s) after applying a profile before probing.
export TUNING_SETTLE_SEC="${TUNING_SETTLE_SEC:-60}"
# ACM hub context running OpenShift GitOps; the sweep pauses Argo CD auto-sync there.
export TUNING_GITOPS_CONTEXT="${TUNING_GITOPS_CONTEXT:-}"
# Argo CD namespace on that context.
export TUNING_GITOPS_NAMESPACE="${TUNING_GITOPS_NAMESPACE:-openshift-gitops}"
# ApplicationSet that generates the per-cluster Istio CR Applications (<cluster>-ossm).
export TUNING_GITOPS_APPSET="${TUNING_GITOPS_APPSET:-spoke-ossm}"
# churn-dataplane sweeps: churn operations per second.
export TUNING_COEXEC_CHURN_RATE="${TUNING_COEXEC_CHURN_RATE:-5}"
# 1 = after each revert, also check that istio-ca-root-cert reaches a new namespace.
export TUNING_REVERT_HEALTHCHECK_NS_PROBE="${TUNING_REVERT_HEALTHCHECK_NS_PROBE:-0}"
# Seconds to wait for istio-ca-root-cert in that namespace.
export TUNING_REVERT_HEALTHCHECK_TIMEOUT="${TUNING_REVERT_HEALTHCHECK_TIMEOUT:-60}"

# === Scale coverage and SLA bands (controlplane) ===
# Workload sizing: fixed (counts from CLI/env) or auto (001 derives the service count from capacity).
export SCALE_SIZING_MODE="${SCALE_SIZING_MODE:-fixed}"
# auto mode: fraction of post-reserve capacity to fill.
export SCALE_TARGET_FRACTION="${SCALE_TARGET_FRACTION:-0.7}"
# Fraction of node allocatable reserved for system pods before sizing.
export SCALE_SYSTEM_RESERVE_FRACTION="${SCALE_SYSTEM_RESERVE_FRACTION:-0.15}"
# Achieved/possible scale below this fraction is reported as under-scaled.
export SCALE_COVERAGE_MIN_FRACTION="${SCALE_COVERAGE_MIN_FRACTION:-0.25}"
# 1 = exit non-zero when under-scaled; 0 = warn only.
export SCALE_COVERAGE_ENFORCE="${SCALE_COVERAGE_ENFORCE:-0}"
# auto mode: estimated CPU (millicores) and memory (MiB) per pod, sidecar included.
export SCALE_PER_POD_CPU_M="${SCALE_PER_POD_CPU_M:-200}"
export SCALE_PER_POD_MEM_MI="${SCALE_PER_POD_MEM_MI:-256}"
# SLA verdict: utilization % at/above FAIL is FAIL, at/above CAUTION is CAUTION, else PASS.
export SCALE_SLA_CAUTION_PCT="${SCALE_SLA_CAUTION_PCT:-75}"
export SCALE_SLA_FAIL_PCT="${SCALE_SLA_FAIL_PCT:-90}"

# === Capacity reads (kubectl get / kubectl top) ===
# Request timeout (s) for kubectl top, which is slower than get.
export CAP_TOP_TIMEOUT="${CAP_TOP_TIMEOUT:-15}"
# Attempts and backoff (s) for each kubectl top read.
export CAP_TOP_ATTEMPTS="${CAP_TOP_ATTEMPTS:-2}"
export CAP_TOP_BACKOFF_S="${CAP_TOP_BACKOFF_S:-2}"
# Page size for the cluster-wide pod list.
export CAP_POD_CHUNK_SIZE="${CAP_POD_CHUNK_SIZE:-500}"
# Max wait (s) before the sweep for the metrics API to serve data; 0 disables the check.
export METRICS_READY_TIMEOUT="${METRICS_READY_TIMEOUT:-120}"
# Poll interval (s) for that check.
export METRICS_READY_INTERVAL="${METRICS_READY_INTERVAL:-10}"
