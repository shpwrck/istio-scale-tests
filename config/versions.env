# Version pins and cluster contexts for the test suites.
# Platform and operator versions live with what installs them (AGENTS.md, Version pins).
# Test defaults live in options.env, sourced at the end of this file.
#
# shellcheck shell=bash

# === Version Pins ===
# Recorded in every TSV preamble. Keep charts/spoke-ossm/values.yaml istioVersion in sync.
export ISTIO_VERSION="${ISTIO_VERSION:-v1.30.5}"
# Fortio image tag. Keep tests/dataplane/chart and tests/churn-dataplane/chart in sync.
export FORTIO_VERSION="${FORTIO_VERSION:-1.75.3}"
# Busybox image tag; the 001 setup scripts pass it to the suite charts. Keep the
# tests/{churn,churn-dataplane,controlplane,propagation}/chart defaults in sync.
export BUSYBOX_VERSION="${BUSYBOX_VERSION:-1.37.0}"
# hashicorp/http-echo tag (the real tag is "1.0", not "1.0.0"). Keep tests/propagation/chart,
# charts/mesh-verify and charts/mesh-verify-gateway-api in sync.
export HTTP_ECHO_VERSION="${HTTP_ECHO_VERSION:-1.0}"

# === Cluster Contexts ===
# Comma-separated kube contexts of the mesh members (not the hub).
export SETUP_CONTEXTS="${SETUP_CONTEXTS:-cluster-002,cluster-003}"

# shellcheck source=options.env
source "$(dirname "${BASH_SOURCE[0]}")/options.env"
